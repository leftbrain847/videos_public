   "act": {
    "girl": {
     "mood": "happy",
     "action": "celebrate"
    },
    "girl2": {
     "mood": "happy",
     "action": "celebrate"
    }
   }
  },
  {
   "text": "Soon, ninety five students are affected. Out of one hundred fifty nine.",
   "cap": "Soon, 95 students are affected. Out of 159.",
   "key": [
    "95"
   ],
   "board": [
    "AFFECTED",
