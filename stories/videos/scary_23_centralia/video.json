   ],
   "speaker": "capy"
  },
  {
   "text": "Old mine tunnels feed it air. It spreads. Slowly. Quietly.",
   "key": [
    "SLOWLY."
   ],
   "shot": {
    "type": "low",
    "on": "chief"
   },
   "act": {
    "chief": {
     "mood": "worried",
     "action": "idle"
    }
   }
  },
  {
   "text": "Crews try digging it out. Over and over. It wins. Every time.",
   "key": [
    "WINS."
