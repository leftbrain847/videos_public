     "action": "idle",
     "look": "you"
    }
   }
  },
  {
   "text": "Your town is basically a natural laboratory now. Thanks to the lights.",
   "key": [
    "LABORATORY"
   ],
   "shot": {
    "type": "medium",
    "on": "you"
   },
   "act": {
    "you": {
     "mood": "neutral",
     "action": "idle",
     "look": "camera"
    }
   }
  },
  {
   "text": "Free light show. No tickets. No explanation.",
   "key": [
    "EXPLANATION."
   ],
   "shot": {
    "type": "close",
    "on": "capy"
   },
   "act": {
    "capy": {
     "mood": "smug",
     "action": "cross",
     "look": "camera"
    }
   },
   "speaker": "capy"
  },
  {
