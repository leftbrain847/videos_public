     "action": "clap",
     "look": "camera"
    }
   },
   "place": {
    "capy": "center"
   }
  },
  {
   "text": "You spend years in prison. Then you're deported to Italy.",
   "key": [
    "DEPORTED"
   ],
   "set": "office",
   "shot": {
    "type": "high",
    "on": "charles"
