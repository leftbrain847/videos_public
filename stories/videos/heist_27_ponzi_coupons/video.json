     "look": "capy"
    }
   },
   "place": {
    "capy": "left",
    "charles": "right"
   }
  },
  {
   "text": "Early investors get paid. With money from newer investors.",
   "key": [
    "NEWER"
   ],
   "shot": {
    "type": "close",
    "on": "charles"
   },
   "act": {
    "charles": {
     "mood": "smug",
     "action": "idle",
     "look": "camera"
    }
   },
   "place": {
    "capy": false,
    "charles": "center"
   }
  },
  {
   "text": "It works great. For a while. Until new money stops coming in.",
   "key": [
    "STOPS."
   ],
   "shot": {
    "type": "medium",
    "on": "inv"
   },
   "act": {
