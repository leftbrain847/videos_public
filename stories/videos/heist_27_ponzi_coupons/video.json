   },
   "board": [
    "PONZI",
    "SCHEME"
   ]
  },
  {
   "text": "Boston, nineteen twenty. You're Charles Ponzi.",
   "cap": "Boston, 1920. You're Charles Ponzi.",
   "key": [
    "PONZI."
   ],
   "shot": {
    "type": "wide",
    "on": "charles"
   },
   "act": {
    "charles": {
     "mood": "smug",
     "action": "talk",
     "look": "camera"
    }
   },
   "place": {
    "capy": false,
    "charles": "center"
   },
   "board": [
    "BOSTON",
    "1920"
   ]
  },
  {
   "text": "You find a real loophole. Postal reply coupons.",
   "key": [
    "COUPONS."
   ],
   "shot": {
    "type": "medium",
    "on": "charles"
   },
   "act": {
    "charles": {
     "mood": "happy",
     "action": "hold",
     "look": "camera"
    }
   }
  },
  {
   "text": "Buy them cheap in one country. Swap them for stamps worth more in another.",
   "key": [
    "STAMPS"
   ],
   "shot": {
    "type": "close",
    "on": "capy"
   },
   "act": {
    "capy": {
     "mood": "neutral",
     "action": "point",
     "look": "camera"
    }
   },
   "place": {
    "capy": "center",
    "charles": false
   }
  },
  {
   "text": "Tiny profit. Per coupon. Very, very tiny. You'd need mountains of coupons.",
   "key": [
    "TINY"
   ],
   "shot": {
    "type": "medium",
    "on": "capy"
   },
   "act": {
    "capy": {
     "mood": "smug",
     "action": "shrug",
     "look": "camera"
    }
   }
  },
  {
   "text": "Your promise to investors? Fifty percent profit in forty five days.",
   "cap": "Your promise to investors? 50% profit in 45 days.",
   "key": [
    "50%"
   ],
   "shot": {
    "type": "two",
    "on": "charles",
    "with": "inv"
   },
   "act": {
    "charles": {
     "mood": "happy",
