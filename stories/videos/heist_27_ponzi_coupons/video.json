    "inv2": "right",
    "charles": false
   }
  },
  {
   "text": "Within months, you take in millions of dollars.",
   "key": [
    "MILLIONS"
   ],
   "shot": {
    "type": "low",
    "on": "charles"
   },
   "act": {
    "charles": {
