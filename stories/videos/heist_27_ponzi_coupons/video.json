    "inv": false,
    "inv2": false
   },
   "board": [
    "$15,000,000"
   ]
  },
  {
   "text": "Here's the secret. You barely buy any coupons.",
   "key": [
    "SECRET."
   ],
   "shot": {
    "type": "two",
    "on": "capy",
    "with": "charles"
   },
   "act": {
