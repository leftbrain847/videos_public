    },
    "you": {
     "mood": "worried",
     "action": "idle",
     "look": "doc"
    }
   }
  },
  {
   "text": "The diagnosis? Hot blood.",
   "key": [
    "BLOOD."
   ],
   "shot": {
    "type": "close",
    "on": "doc"
   },
   "act": {
    "doc": {
     "mood": "smug",
     "action": "idle",
     "look": "camera"
    }
   }
  },
  {
   "text": "The cure? More dancing. Seriously.",
   "key": [
    "MORE"
   ],
   "place": {
    "capy": [
     -2.2,
     0.8
    ],
    "you": [
     -4.6,
     -0.4
    ]
   },
   "shot": {
    "type": "two",
    "on": "capy",
    "with": "doc"
   },
   "act": {
