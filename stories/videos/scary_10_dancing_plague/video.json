     "mood": "sad",
     "action": "celebrate"
    },
    "you": {
     "mood": "worried",
     "action": "idle",
     "look": "dancer"
    }
   }
  },
  {
   "text": "They look exhausted. Some look terrified. Nobody can stop.",
   "key": [
    "TERRIFIED."
   ],
   "shot": {
    "type": "low",
    "on": "dancer"
   },
   "act": {
    "dancer": {
     "mood": "worried",
     "action": "celebrate",
     "look": "camera"
    }
   }
  },
  {
