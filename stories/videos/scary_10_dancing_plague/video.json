    },
    "capy": {
     "mood": "confused",
     "action": "idle",
     "look": "prof"
    }
   }
  },
  {
   "text": "One idea is stress turning into mass hysteria.",
   "key": [
    "HYSTERIA."
   ],
   "shot": {
    "type": "close",
    "on": "prof"
   },
   "act": {
    "prof": {
     "mood": "neutral",
     "action": "talk",
     "look": "camera"
    }
   }
  },
  {
   "text": "Famine. Disease. A city at its absolute limit. Stress everywhere.",
   "key": [
    "LIMIT."
   ],
   "shot": {
    "type": "two",
    "on": "capy",
    "with": "prof"
   },
   "act": {
    "capy": {
     "mood": "sad",
     "action": "talk",
     "look": "camera"
    },
    "prof": {
     "mood": "sad",
     "action": "idle",
     "look": "capy"
    }
   },
   "speaker": "capy"
  },
  {
   "text": "Another idea blames moldy grain. A fungus called ergot.",
   "key": [
    "ERGOT."
   ],
   "shot": {
    "type": "medium",
    "on": "prof"
   },
   "act": {
    "prof": {
     "mood": "smug",
     "action": "point",
     "look": "camera"
    }
   }
  },
  {
   "text": "Either way, the dance floor was not safe. Sit this one out.",
   "key": [
    "SAFE."
   ],
   "shot": {
    "type": "low",
    "on": "capy"
   },
   "act": {
    "capy": {
     "mood": "smug",
     "action": "idle",
     "look": "camera"
    }
   },
   "speaker": "capy"
  },
  {
   "text": "Five hundred years later, still no clear answer.",
   "key": [
    "ANSWER."
   ],
   "shot": {
    "type": "close",
    "on": "capy"
   },
   "act": {
    "capy": {
