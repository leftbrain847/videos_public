    }
   },
   "speaker": "capy"
  },
  {
   "text": "Dancers are taken to a hilltop shrine. Saint Vitus.",
   "key": [
    "VITUS."
   ],
   "shot": {
    "type": "medium",
    "on": "dancer"
   },
   "act": {
    "dancer": {
     "mood": "sad",
     "action": "idle",
     "look": "camera"
    }
   }
  },
  {
   "text": "By September, it fades away. As strangely as it started.",
   "key": [
    "FADES"
   ],
   "shot": {
    "type": "close",
    "on": "dancer"
   },
   "act": {
    "dancer": {
     "mood": "neutral",
     "action": "idle",
     "look": "camera"
    }
   }
  },
  {
   "text": "So what happened? Historians still argue. Loudly.",
   "key": [
    "ARGUE."
   ],
   "set": "study",
   "setOpts": {
    "boardText": [
     "THEORIES",
     "1518"
    ]
   },
   "place": {
    "prof": [
     0,
