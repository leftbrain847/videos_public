     "mood": "happy",
     "action": "celebrate"
    },
    "you": {
     "mood": "confused",
     "action": "idle",
     "look": "dancer"
    }
   }
  },
  {
   "text": "A woman named Frau Troffea dances for days. Alone, at first.",
   "key": [
    "DAYS."
   ],
   "shot": {
    "type": "medium",
    "on": "dancer"
   },
   "act": {
    "dancer": {
     "mood": "worried",
     "action": "celebrate",
     "look": "camera"
    }
   }
  },
  {
   "text": "No music. No party. Just dancing. People stop to stare.",
   "key": [
    "DANCING."
   ],
   "shot": {
    "type": "close",
    "on": "you"
   },
   "act": {
    "you": {
     "mood": "confused",
     "action": "idle",
     "look": "camera"
    }
   }
  },
  {
   "text": "Within a week, dozens more join her.",
   "key": [
    "DOZENS"
   ],
   "place": {
    "capy": [
     -2.2,
     0.6
    ],
    "you": [
     0.6,
     0
    ],
    "dancer": [
     3.0,
     -1.0
    ]
   },
   "shot": {
    "type": "two",
    "on": "capy",
    "with": "you"
   },
   "act": {
    "capy": {
     "mood": "shocked",
     "action": "talk",
     "look": "camera"
    },
    "you": {
     "mood": "shocked",
     "action": "idle",
     "look": "capy"
    },
    "dancer": {
     "mood": "sad",
     "action": "celebrate"
    }
   },
   "speaker": "capy"
  },
  {
   "text": "By August, some reports say four hundred people.",
   "cap": "By August, some reports say 400 people.",
   "key": [
    "400"
   ],
   "board": [
    "DANCERS",
    "~400?"
