    },
    "capy": {
     "mood": "worried",
     "action": "idle",
     "look": "dancer"
    }
   }
  },
  {
   "text": "So the leaders flip. Now music is banned.",
   "key": [
    "BANNED."
   ],
   "shot": {
    "type": "two",
    "on": "you",
    "with": "capy"
   },
   "act": {
    "you": {
     "mood": "angry",
