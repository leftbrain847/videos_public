    }
   },
   "speaker": "capy"
  },
  {
   "text": "July, fifteen eighteen. The city of Strasbourg.",
   "cap": "July 1518. The city of Strasbourg.",
   "key": [
    "STRASBOURG."
   ],
   "board": [
    "JULY 1518",
    "STRASBOURG"
   ],
   "shot": {
    "type": "wide",
