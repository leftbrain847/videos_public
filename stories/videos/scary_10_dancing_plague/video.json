     "mood": "shocked",
     "action": "idle",
     "look": "doc"
    },
    "doc": {
     "mood": "happy",
     "action": "point",
     "look": "capy"
    }
   },
   "speaker": "capy"
  },
  {
   "text": "They clear halls. They build a stage. They hire musicians.",
   "key": [
    "MUSICIANS."
   ],
   "shot": {
    "type": "medium",
    "on": "doc"
   },
   "act": {
    "doc": {
     "mood": "happy",
     "action": "cheer",
     "look": "camera"
    }
   }
  },
  {
   "text": "Your city's medical plan was a dance party.",
   "key": [
    "PARTY."
   ],
   "shot": {
    "type": "low",
    "on": "capy"
   },
   "act": {
    "capy": {
     "mood": "smug",
     "action": "cross",
     "look": "camera"
    }
   },
   "speaker": "capy"
  },
  {
   "text": "It does not work. More people join in. The music just makes it worse.",
   "key": [
    "JOIN"
