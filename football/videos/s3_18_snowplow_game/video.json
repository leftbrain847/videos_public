 },
 "lines": [
  {"text": "In 1982, a snowplow decided an NFL game.", "key": ["SNOWPLOW"],
   "place": {"kicker": false, "coach": false, "rival": false, "capy": [-2.4, 0.8], "driver": [0.6, 0]},
   "shot": {"type": "two", "on": "capy", "with": "driver"},
   "act": {"capy": {"mood": "smug", "action": "talk", "look": "camera"}, "driver": {"mood": "happy", "action": "wave", "look": "capy"}}, "speaker": "capy"},
  {"text": "Miami at New England, in a snowstorm. Nobody could score.", "key": ["SNOWSTORM.", "NOBODY"],
   "place": {"capy": false, "driver": false, "kicker": [0, 0]},
   "shot": {"type": "high", "on": "kicker"},
   "act": {"kicker": {"mood": "worried", "action": "cross", "look": "camera"}}},
  {"text": "Late in the fourth quarter, it was still zero to zero.", "cap": "Late in the 4th quarter, it was still 0 to 0.", "key": ["0", "TO"],
   "place": {"kicker": [4.6, 0.5], "coach": [6.6, 0.5]},
   "shot": {"type": "low", "on": "kicker", "offset": [-1.3, 1.4, 3]},
   "act": {"kicker": {"mood": "worried", "action": "cross", "look": "camera"}, "coach": {"mood": "angry", "action": "cross", "look": "kicker"}}},
  {"text": "With four forty five left, New England called timeout before a field goal try.", "cap": "With 4:45 left, New England called timeout before a field goal try.", "key": ["4:45", "TIMEOUT"],
   "place": {"kicker": [-1.2, 0], "coach": [1.2, 0]},
   "shot": {"type": "two", "on": "kicker", "with": "coach"},
   "act": {"coach": {"mood": "smug", "action": "point", "look": "kicker"}, "kicker": {"mood": "neutral", "action": "idle", "look": "coach"}}},
  {"text": "Then their coach sent a man out on a John Deere tractor.", "key": ["TRACTOR."],
   "shot": {"type": "close", "on": "coach"},
   "act": {"coach": {"mood": "smug", "action": "point", "look": "camera"}}},
  {"text": "He swept a clean patch in the snow, right where the kick would go down.", "key": ["CLEAN", "PATCH"],
   "place": {"coach": false, "kicker": false, "driver": [0, 0.5]},
   "shot": {"type": "wide", "on": "driver"},
   "act": {"driver": {"mood": "happy", "action": "point"}}},
  {"text": "The driver? Mark Henderson. A burglar on a prison work release program.", "key": ["PRISON"],
   "shot": {"type": "medium", "on": "driver"},
   "act": {"driver": {"mood": "smug", "action": "shrug", "look": "camera"}}},
  {"text": "John Smith kicked it from thirty three yards. Good.", "cap": "John Smith kicked it from 33 yards. Good.", "key": ["33", "GOOD."],
   "place": {"driver": false, "kicker": [0, 0]},
   "shot": {"type": "low", "on": "kicker"},
   "act": {"kicker": {"mood": "happy", "action": "cheer", "look": "camera"}}},
  {"text": "Final score: three to nothing.", "cap": "Final score: 3 to 0.", "key": ["3"],
   "board": ["NEW ENG 3", "MIAMI 0"],
   "place": {"kicker": [4.6, 0.5], "driver": [6.6, 0.5]},
   "shot": {"type": "low", "on": "kicker", "offset": [-1.3, 1.4, 3]},
   "act": {"kicker": {"mood": "happy", "action": "cheer", "look": "camera"}, "driver": {"mood": "happy", "action": "wave", "look": "camera"}}},
  {"text": "Miami coach Don Shula was furious, and he protested.", "key": ["FURIOUS,", "PROTESTED."],
   "set": "press", "setOpts": {"boardText": ["POSTGAME"]}, "board": ["POSTGAME"],
   "place": {"rival": "center"},
   "shot": {"type": "medium", "on": "rival"},
   "act": {"rival": {"mood": "angry", "action": "point", "look": "camera"}}, "speaker": "rival"},
  {"text": "The three points stood anyway.", "cap": "The 3 points stood anyway.", "key": ["STOOD"],
   "place": {"capy": [-1.8, 0.6]},
   "shot": {"type": "two", "on": "capy", "with": "rival"},
   "act": {"capy": {"mood": "smug", "action": "shrug", "look": "camera"}, "rival": {"mood": "angry", "action": "facepalm"}}, "speaker": "capy"},
  {"text": "But the league then banned snow clearing help during play.", "key": ["BANNED"],
   "board": ["NEW RULE:", "NO PLOWS"],
   "shot": {"type": "close", "on": "rival"},
   "act": {"rival": {"mood": "smug", "action": "hold", "look": "camera"}}},
  {"text": "And the tractor? It now hangs from the ceiling at the Patriots Hall of Fame.", "key": ["CEILING"],
   "set": "tunnel", "setOpts": {"boardText": ["HALL OF FAME"]}, "board": ["HALL OF FAME"],
   "place": {"driver": "center"},
   "shot": {"type": "wide", "on": "driver"},
   "act": {"driver": {"mood": "happy", "action": "point", "look": "camera"}}},
  {"text": "So, was the plow fair play or genius? One word.", "key": ["FAIR", "GENIUS?"],
   "set": "locker", "setOpts": {"boardText": ["FAIR", "OR GENIUS?"]}, "board": ["FAIR", "OR GENIUS?"],
   "place": {"capy": [-1.4, 1.0], "driver": [1.2, 0]},
   "shot": {"type": "two", "on": "capy", "with": "driver"},
   "act": {"capy": {"mood": "smug", "action": "talk", "look": "camera"}, "driver": {"mood": "smug", "action": "shrug", "look": "capy"}}, "speaker": "capy"}
 ],
