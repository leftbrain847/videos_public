    },
    "def": {
     "mood": "smug",
     "look": "rb"
    }
   }
  },
  {
   "text": "Justin Forsett runs. His knee and elbow touch the turf.",
   "key": [
    "KNEE"
   ],
   "place": {
    "def": [
     1.4,
     -0.1
    ]
   },
   "shot": {
    "type": "two",
