    },
    "coach": {
     "mood": "shocked",
     "action": "shrug",
     "look": "ref"
    }
   }
  },
  {
   "text": "Plus fifteen yards, for unsportsmanlike conduct.",
   "cap": "Plus 15 yards, for unsportsmanlike conduct.",
   "key": [
    "15"
   ],
   "shot": {
    "type": "close",
    "on": "coach"
   },
   "act": {
    "coach": {
     "mood": "sad",
     "action": "idle",
     "look": "camera"
    }
   }
  },
  {
   "text": "So the touchdown stands.",
   "key": [
    "STANDS."
   ],
   "place": {
    "ref": false,
    "coach": false,
    "rb": "center"
   },
   "shot": {
