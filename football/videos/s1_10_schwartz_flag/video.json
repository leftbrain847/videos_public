    "with": "def"
   },
   "act": {
    "rb": {
     "mood": "worried",
     "action": "hold"
    },
    "def": {
     "mood": "happy",
     "action": "point",
     "look": "rb"
    }
   }
  },
  {
   "text": "No whistle. He keeps going. Eighty one yards. Touchdown.",
   "cap": "No whistle. He keeps going. 81 yards. Touchdown.",
   "key": [
    "81",
    "TOUCHDOWN."
   ],
   "place": {
    "def": false
   },
   "shot": {
    "type": "low",
    "on": "rb"
   },
   "act": {
    "rb": {
     "mood": "happy",
     "action": "cheer",
     "look": "camera"
    }
   }
  },
  {
   "text": "Every scoring play gets reviewed automatically. And replays showed he was down.",
   "key": [
    "AUTOMATICALLY."
   ],
   "set": "locker",
   "setOpts": {
    "boardText": [
     "SCORING PLAY",
     "= AUTO REVIEW"
    ]
   },
   "place": {
    "capy": "left",
