     "look": "capy"
    }
   },
   "speaker": "capy"
  },
  {
   "text": "But Detroit's coach, Jim Schwartz, throws his challenge flag anyway.",
   "key": [
    "CHALLENGE",
    "FLAG"
   ],
   "set": "field",
   "setOpts": {
    "boardText": [
     "THANKSGIVING",
     "3RD QTR"
    ]
   },
   "place": {
    "coach": "center"
   },
   "shot": {
    "type": "medium",
