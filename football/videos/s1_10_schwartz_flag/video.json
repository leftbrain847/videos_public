   },
   "act": {
    "coach": {
     "mood": "angry",
     "action": "throw"
    }
   }
  },
  {
   "text": "The rule then: challenge a play that's reviewed automatically, and there's no review at all.",
   "key": [
    "NO",
    "REVIEW"
   ],
   "place": {
    "ref": [
     -2.0,
     0.4
    ]
   },
   "shot": {
