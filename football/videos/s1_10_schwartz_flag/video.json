    }
   },
   "speaker": "capy"
  },
  {
   "text": "Houston at Detroit. Third quarter. Detroit is up ten.",
   "cap": "Houston at Detroit. 3rd quarter. Detroit is up 10.",
   "key": [
    "10."
   ],
   "place": {
