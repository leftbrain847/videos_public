     "look": "camera"
    }
   }
  },
  {
   "text": "Schwartz said he got so mad that he overreacted.",
   "key": [
    "OVERREACTED."
   ],
   "set": "press",
   "setOpts": {
    "boardText": [
     "POSTGAME"
