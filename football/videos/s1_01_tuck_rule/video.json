  "own2": {"look": {"outfit": "suit", "shirt": "#3a3f55", "pants": "#3a3f55", "hair": "short", "hairColor": "#cfcfcf", "skin": "#d9a27a"}, "at": "right"}
 },
 "lines": [
  {"text": "In a 2002 playoff game, the NFL decided a fumble was actually a pass.",
   "key": ["FUMBLE", "PASS."],
   "place": {"capy": [-1.4, 0.8], "qb": [0.9, 0], "cb": false, "ref": false, "own1": false, "own2": false},
   "shot": {"type": "two", "on": "capy", "with": "qb"},
   "act": {"capy": {"mood": "smug", "action": "talk", "look": "camera"}, "qb": {"mood": "confused", "action": "shrug", "look": "capy"}},
   "speaker": "capy"},
  {"text": "Snow in New England. Oakland led thirteen to ten, under two minutes left.",
   "cap": "Snow in New England. Oakland led 13 to 10, under 2 minutes left.",
   "key": ["13", "10,"],
   "place": {"capy": false, "qb": "center", "cb": [1.6, -2.2]},
   "shot": {"type": "wide", "on": "qb", "offset": [3, 2.5, 4]},
   "act": {"qb": {"mood": "worried", "action": "hold"}, "cb": {"mood": "angry", "look": "qb"}}},
  {"text": "Tom Brady pumped the ball, then pulled it back toward his body.",
   "key": ["PUMPED"],
   "shot": {"type": "medium", "on": "qb"},
   "act": {"qb": {"mood": "neutral", "action": "throw"}}},
  {"text": "Charles Woodson hit him. The ball came loose.",
   "key": ["LOOSE."],
   "place": {"cb": [1.0, -0.6]},
   "shot": {"type": "two", "on": "qb", "with": "cb"},
   "act": {"qb": {"mood": "shocked", "action": "shrug"}, "cb": {"mood": "angry", "action": "point", "look": "qb"}}},
  {"text": "Oakland recovered. Called a fumble. That should have ended it.",
   "key": ["FUMBLE."],
   "shot": {"type": "low", "on": "cb"},
   "act": {"cb": {"mood": "happy", "action": "cheer", "look": "camera"}, "qb": {"mood": "sad", "action": "slump"}}},
  {"text": "Then the referee went to replay.",
   "key": ["REPLAY."],
   "place": {"ref": [-1.2, 0.6]},
   "shot": {"type": "medium", "on": "ref"},
   "act": {"ref": {"mood": "neutral", "action": "hold", "look": "camera"}, "cb": {"mood": "worried", "look": "ref"}}},
  {"text": "And he found the tuck rule.",
   "key": ["TUCK", "RULE."],
   "place": {"capy": [-2.8, 1.2]},
   "shot": {"type": "two", "on": "ref", "with": "capy"},
   "act": {"ref": {"mood": "smug", "action": "point", "look": "capy"}, "capy": {"mood": "neutral", "action": "idle", "look": "ref"}}},
  {"text": "If the arm is moving forward, and the ball comes out while he tucks it back, it's a pass.",
   "key": ["FORWARD,", "PASS."],
   "set": "locker",
   "setOpts": {"boardText": ["ARM FORWARD", "= PASS"]},
   "place": {"capy": "left", "qb": "right"},
   "shot": {"type": "two", "on": "capy", "with": "qb"},
   "act": {"capy": {"mood": "neutral", "action": "point", "look": "camera"}, "qb": {"mood": "confused", "action": "throw", "look": "capy"}},
   "speaker": "capy"},
  {"text": "Not a fumble. An incomplete pass. Patriots ball.",
   "key": ["INCOMPLETE"],
   "set": "field",
   "setOpts": {"boardText": ["FUMBLE?", "INCOMPLETE"]},
   "place": {"ref": "center", "cb": [-2.0, 0.4], "qb": [2.0, 0.4]},
   "shot": {"type": "wide", "on": "ref"},
   "act": {"ref": {"mood": "neutral", "action": "wave"}, "cb": {"mood": "angry", "action": "facepalm"}, "qb": {"mood": "happy", "action": "clap"}}},
  {"text": "New England kicked a field goal in the snow to tie it.",
   "key": ["TIE"],
   "shot": {"type": "close", "on": "cb"},
   "act": {"cb": {"mood": "shocked", "action": "idle", "look": "camera"}}},
  {"text": "Then won in overtime. Then won the Super Bowl.",
   "key": ["SUPER", "BOWL."],
   "place": {"ref": false, "cb": false, "qb": "center"},
   "shot": {"type": "low", "on": "qb"},
   "act": {"qb": {"mood": "happy", "action": "cheer", "look": "camera"}}},
  {"text": "Eleven years later, the owners voted to delete the rule. Twenty nine to one.",
   "cap": "11 years later, the owners voted to delete the rule. 29 to 1.",
   "key": ["DELETE", "29"],
   "set": "office",
   "setOpts": {"boardText": ["TUCK RULE", "29 - 1"]},
   "place": {"own1": "left", "own2": "right", "capy": false},
   "shot": {"type": "two", "on": "own1", "with": "own2"},
   "act": {"own1": {"mood": "neutral", "action": "hold", "look": "own2"}, "own2": {"mood": "smug", "action": "point", "look": "own1"}}},
  {"text": "The Patriots did not vote.",
   "key": ["NOT"],
   "place": {"capy": [0, 0.8]},
   "shot": {"type": "medium", "on": "capy"},
   "act": {"capy": {"mood": "smug", "action": "shrug", "look": "camera"}, "own1": {"mood": "confused", "look": "capy"}, "own2": {"mood": "confused", "look": "capy"}},
   "speaker": "capy"},
  {"text": "So what was it really, a fumble or a pass? One word, below.",
   "key": ["FUMBLE", "PASS?"],
   "set": "locker",
   "setOpts": {"boardText": ["FUMBLE", "OR PASS?"]},
   "place": {"capy": "left", "qb": "right"},
   "shot": {"type": "two", "on": "capy", "with": "qb"},
