   },
   "act": {
    "qb": {
     "mood": "neutral",
     "action": "throw"
    }
   }
  },
  {
   "text": "He dives, pins the ball to his chest, and lands.",
   "key": [
    "DIVES,"
   ],
   "place": {
    "qb": false,
    "def": false,
    "wr": "center"
   },
   "shot": {
