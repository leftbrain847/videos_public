   },
   "act": {
    "wr": {
     "mood": "happy",
     "action": "hold",
     "look": "camera"
    }
   }
  },
  {
   "text": "The tip of the ball touches the turf. It doesn't move.",
   "key": [
    "TOUCHES"
   ],
   "shot": {
    "type": "close",
    "on": "wr"
   },
   "act": {
    "wr": {
     "mood": "neutral",
     "action": "hold",
     "look": "camera"
    }
   }
  },
  {
   "text": "Replay takes a look anyway.",
   "key": [
