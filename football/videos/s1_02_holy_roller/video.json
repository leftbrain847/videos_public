    }
   },
   "speaker": "capy"
  },
  {
   "text": "Ten seconds left. Down twenty to fourteen, at the San Diego fourteen.",
   "cap": "10 seconds left. Down 20 to 14, at the San Diego 14.",
   "key": [
    "10",
