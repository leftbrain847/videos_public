    "def": {
     "mood": "angry",
     "look": "qb"
    }
   }
  },
  {
   "text": "Ken Stabler dropped back. Nobody open. A defender about to sack him.",
   "key": [
    "SACK"
   ],
   "place": {
    "def": [
     1.1,
     -0.7
    ]
   },
