     "mood": "angry",
     "action": "point",
     "look": "qb"
    }
   }
  },
  {
   "text": "So he pushed the ball forward, toward the end zone.",
   "key": [
    "FORWARD,"
   ],
   "shot": {
    "type": "medium",
    "on": "qb"
   },
   "act": {
    "qb": {
     "mood": "smug",
     "action": "throw",
     "look": "camera"
    }
   }
  },
  {
   "text": "Pete Banaszak couldn't grab it. He swatted it further.",
   "key": [
    "SWATTED"
   ],
   "place": {
    "qb": false,
    "def": false,
    "rb": "center"
   },
   "shot": {
