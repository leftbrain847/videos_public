     "action": "cross",
     "look": "camera"
    }
   }
  },
  {
   "text": "In February, he started the Super Bowl. Chiefs thirty one, Niners twenty.",
   "cap": "In February, he started the Super Bowl. Chiefs 31, Niners 20.",
   "key": [
    "31,"
   ],
   "shot": {
