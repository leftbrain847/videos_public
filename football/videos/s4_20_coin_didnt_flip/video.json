 "lines": [
  {"text": "In a 2016 playoff game, the overtime coin toss didn't flip. At all.",
   "key": ["FLIP."], "speaker": "capy",
   "place": {"capy": [-2.2, 0.8], "ref": [0, 0], "qb": [2.0, 0.2], "wr": false, "lb": false, "card": false},
