   "act": {"capy": {"mood": "smug", "action": "talk", "look": "camera"}, "ref": {"mood": "confused", "action": "shrug"}, "qb": {"mood": "angry", "action": "cross", "look": "ref"}}},
  {"text": "Packers at Cardinals. Green Bay down seven, fourth-and-twenty from its own four.",
   "cap": "Packers at Cardinals. Green Bay down 7, 4th-and-20 from its own 4.",
   "key": ["4TH-AND-20"],
