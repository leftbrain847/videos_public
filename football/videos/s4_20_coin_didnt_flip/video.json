   "place": {"qb": "center"},
   "shot": {"type": "medium", "on": "qb"},
   "act": {"qb": {"mood": "angry", "action": "shrug", "look": "camera"}}},
  {"text": "First play of overtime: Larry Fitzgerald, seventy five yards.",
